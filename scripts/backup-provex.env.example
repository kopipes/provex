# Provex backup configuration
# Copy to /etc/backup-provex.env and fill in real values.
# Keep this file root-only: chmod 600 /etc/backup-provex.env

# Absolute path to the SQLite database on the host (bind-mounted into the container)
SRC_DB_PATH=/var/www/provex/backend/reimburseeasy.db

# Absolute path to the receipt uploads directory on the host
SRC_UPLOADS_PATH=/var/www/provex/backend/uploads

# Directory containing docker-compose.yml (used by the restore script)
PROVEX_DIR=/var/www/provex

# Cloudflare R2 credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=provex

# How long database backups are kept in R2 (days)
RETENTION_DAYS=365

# Optional: set to encrypt database backups with GPG (AES256).
# Leave unset for unencrypted backups. If you enable it later, set it to the
# same value when restoring.
# GPG_PASSPHRASE=
