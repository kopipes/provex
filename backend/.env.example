# Backend environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real .env file.

# JWT signing key. MUST be set in production: if absent, the application falls
# back to a public default value and anyone can forge authentication tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-strong-random-value

# Fernet key used to encrypt the AI provider API key stored in the database.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: never change this after data exists, or stored API keys become unreadable.
ENCRYPTION_KEY=

# SQLite (default) or any SQLAlchemy URL
DATABASE_URL=sqlite:///./reimburseeasy.db

DEBUG=false
ALLOWED_ORIGINS=https://provex.provaliantgroup.com

# Notiv notification channel (password reset delivery).
# Create an integration once in Notiv and store its nv_... key here.
# If unset, the forgot-password channel is disabled and the API reports channel_enabled=false.
NOTIV_API_KEY=
NOTIV_URL=https://notiv.provaliantgroup.com
# Used to build the optional action_url in reset notifications
APP_BASE_URL=https://provex.provaliantgroup.com
# Password reset token lifetime (minutes)
PASSWORD_RESET_TTL_MINUTES=30
